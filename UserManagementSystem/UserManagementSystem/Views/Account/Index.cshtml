@model UserManagementSystem.Models.LoginViewModel

@{
    //set the tile
    ViewData["Title"] = "Login Page";
}



<form method="post" asp-action="Login" asp-controller="Account">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReturnUrl"/>
    <h2>Login In here!</h2>

    <div style="width:300px; margin:40px auto;">
        <div style="margin-bottom:15px;">
            <label style="display:inline-block; width:90px;">Username</label>
            <input type="text" name="username" />
        </div>

        <div style="margin-bottom:15px;">
            <label style="display:inline-block; width:90px;">Password</label>
            <input type="password" name="password" />
        </div>

        <div style="padding-left:94px;">
            <button type="submit" name="submitButton" value="Login">Login</button>
            <button type="submit" name="submitButton" value="Register">Register</button>
        </div>

        <!-- Taken from: https://www.w3tutorials.net/blog/asp-net-core-simplest-possible-forms-authentication/#project-setup -->
        <br />
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }
    </div>
</form>

<p style="color:red;">@ViewBag.Message</p>