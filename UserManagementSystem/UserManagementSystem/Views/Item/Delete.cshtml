@{
    ViewData["Title"] = "Delete Item";
}

<h2>Delete Item</h2>

<form asp-controller="Item" asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this item?');">
    @Html.AntiForgeryToken()
    <div>
        <label>Enter Item ID:</label>
        <input type="number" name="id" required />
    </div>

    <button type="submit">Delete</button>
    <a asp-controller="Item" asp-action="Index">Back</a>
</form>