@using Microsoft.AspNetCore.Mvc.ModelBinding @*For strongly typed error variable*@
@model UserManagementSystem.Models.UpdateViewModel

@{
    ViewData["Title"] = "Update Item";
}

<h2>Update Item</h2>
<!--post back-->
<form asp-action="Update" method="post">
    @Html.AntiForgeryToken()

    <!-- Hidden ID -->
    <input type="hidden" asp-for="ItemID" />

    <div style="margin-bottom:12px;">
        <label for="ItemName">Item Name:</label>
        <!-- To prefill fields -->
        <input type="text" asp-for="ItemName" />
    </div>

    <div style="margin-bottom:12px;">
        <label for="Description">Description:</label>
        <input type="text" asp-for="Description" />
    </div>

    <div style="margin-bottom:12px;">
        <label for="Quantity">Quantity:</label>
        <input type="number" asp-for="Quantity" />
    </div>

    <button type="submit"
            style="width:120px; padding:8px; border:1px solid #007bff; background:#007bff; color:white; cursor:pointer; text-align:center; border-radius:4px;">
        Update Item
    </button>

    <a asp-action="Index"
       style="width:120px; padding:8px; border:1px solid #007bff; background:#007bff; color:white; text-decoration:none; display:inline-block; text-align:center; margin-left:10px; border-radius:4px;">
        Back
    </a>

    <br />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (ModelError error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }
</form>