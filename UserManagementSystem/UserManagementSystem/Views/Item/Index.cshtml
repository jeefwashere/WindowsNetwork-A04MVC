 @model List<UserManagementSystem.Models.UserItem>

@{
    ViewData["Title"] = "Item List";
}

<div style="display:flex; min-height:400px;">

    <div style="flex:1; padding:20px;">
        <h2>Item List</h2>

     

        <table>
            <thead>
                <tr>
                  
                    <th width="300">Name</th>
                    <th width="300">Description</th>
                    <th width="300">Quantity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {<!--for loop to show the idem-->
                    <tr>
                        
                        <td>@item.ItemName</td>
                        <td>@item.Description</td>
                        <td>@item.Quantity</td>
                        <td>
                            <div style="display:flex; align-items:center; gap:8px;">

                                <!-- Update -->
                                <a asp-action="Update" asp-route-id="@item.UserItemId"
                                   style="padding:6px 12px; background-color:#007bff; color:white; text-decoration:none; border-radius:4px;">
                                    Update
                                </a>

                                <form asp-controller="Item" asp-action="Delete" method="post" style="margin:0;" class="delete-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.UserItemId" />
                                    <button type="button"
                                            class="delete-btn"
                                            style="padding:6px 12px; background-color:#007bff; color:white; border:none; border-radius:4px;">
                                        Delete
                                    </button>
                                </form>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div style="width:220px; padding: 35px; ">
        <a asp-controller="Item" asp-action="Add"
		   style="display:inline-block; padding:10px 16px; background:#007bff; color:white; text-decoration:none; border-radius:4px;">
            Add Item
        </a>
        <br /><br />
    </div>
    <div id="deletePopup" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.3);">
        <div style="width:300px; background:white; padding:20px; border-radius:8px; position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); text-align:center;">
            <p>Are you sure you want to delete this item?</p>

            <button type="button" id="confirmDelete">Delete</button>
            <button type="button" id="cancelDelete">Cancel</button>
        </div>
    </div>
</div>

<script>
    let currentForm = null;

    document.querySelectorAll(".delete-btn").forEach(button => {
        button.addEventListener("click", function () {
            currentForm = this.closest(".delete-form");
            document.getElementById("deletePopup").style.display = "block";
        });
    });

    document.getElementById("cancelDelete").addEventListener("click", function () {
        currentForm = null;
        document.getElementById("deletePopup").style.display = "none";
    });

    document.getElementById("confirmDelete").addEventListener("click", function () {
        if (currentForm) {
            currentForm.submit();
        }
    });
</script>